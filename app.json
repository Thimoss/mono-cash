{
  "expo": {
    "name": "mono-cash",
    "slug": "mono-cash",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/expo.icon/app-icon.png",
    "scheme": "monocash",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121214",
        "foregroundImage": "./assets/expo.icon/icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121214",
          "image": "./assets/expo.icon/splash.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
